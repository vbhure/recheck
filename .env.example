# Environment variables for the OPTIONAL live-provider path. Recheck does not
# load a .env file: export these in your shell (or set them in your IDE).
#
# Recheck does NOT read credentials from this file or from anywhere else.
# Each provider resolves its own credentials through its own standard
# mechanism (the AWS credential chain, ANTHROPIC_API_KEY). Recheck only
# reports whether a credential could be RESOLVED, never its value.
#
# None of this is required. The canonical verification path is --scripted,
# which needs no provider, no credential and no network.

# Default provider for `recheck preflight` only: bedrock | anthropic | ollama
# audit and sweep use a live model only when you pass --model <provider>, so
# this variable alone never starts paid calls.
# RECHECK_PROVIDER=bedrock

# Provider-specific model identifier. Defaults per provider:
#   bedrock    global.anthropic.claude-haiku-4-5
#   anthropic  claude-haiku-4-5
#   ollama     llama3.2:3b
# RECHECK_MODEL_ID=

# AWS region (bedrock only). AWS_REGION is also honoured.
# RECHECK_REGION=us-west-2

# Preflight does not probe EC2 instance metadata for AWS credentials. On an
# EC2 instance whose role supplies them, opt in with:
# AWS_EC2_METADATA_DISABLED=false

# Ollama server (ollama only). Defaults to http://localhost:11434
# A user:password in the URL is redacted wherever Recheck prints it.
# RECHECK_OLLAMA_HOST=http://localhost:11434

# The provider SDKs' own endpoint overrides are not Recheck settings, but
# preflight shows them, and refuses one that is not https or loopback,
# because the SDK sends your credential to it:
#   ANTHROPIC_BASE_URL (anthropic)
#   AWS_ENDPOINT_URL_BEDROCK_RUNTIME, AWS_ENDPOINT_URL (bedrock)

# Wall-clock budget for a single classification call, in seconds.
# RECHECK_TIMEOUT_S=30

# Output token cap for the classification call. The default fits the largest
# answer the schema admits (40 classifications).
# RECHECK_MAX_TOKENS=4096
